# Copy this file to .env and fill in your keys. .env is git-ignored.

# OpenAI (ChatGPT / GPT-5.x judge) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (proxy, Azure gateway, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini judge — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: defaults to Google's OpenAI-compatible endpoint
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: Hugging Face token for downloading gated local judge weights
# HF_TOKEN=
